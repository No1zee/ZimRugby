# Supabase configuration for Authentication and Database
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Directus configuration for CMS and Administration
NEXT_PUBLIC_DIRECTUS_URL="YOUR_DIRECTUS_URL"
# Read-only token for public content reads (news, matches, players, etc.).
# Falls back to DIRECTUS_TOKEN if unset.
DIRECTUS_READ_TOKEN="YOUR_DIRECTUS_READ_ONLY_TOKEN"
DIRECTUS_TOKEN="YOUR_DIRECTUS_ADMIN_TOKEN"

# Admin authentication (fail-closed: a role is only active when its password
# is set here. No credentials are stored in source code.)
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
# Optional additional roles:
# EDITOR_PASSWORD=""
# MEDIA_PASSWORD=""
# AUDITOR_PASSWORD=""

# Supabase service-role key — REQUIRED for the admin dashboard to read
# Fan Zone members and Onboarding submissions (anonymous reads are RLS-blocked).
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Note: Do not place sensitive secret keys in NEXT_PUBLIC_ variables.
# For server-only access, use server-only environment variables.

NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
