# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Large source asset directories (served via public/images/cutouts/ instead)
Gallery/cutouts/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Antigravity artifacts
/artifacts

# Headroom Cache
.headroom/

# Environment Variables
.env*
!.env.example
